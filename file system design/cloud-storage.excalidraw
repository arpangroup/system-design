    {
      "id": "R3QH_fA9VetYgb6PcYqJf",
      "type": "text",
      "x": -269.0821034364577,
      "y": 4765.2062384854835,
      "width": 800,
      "height": 240,
      "angle": 0,
      "strokeColor": "#52575c",
      "backgroundColor": "#ffffff",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b5x",
      "roundness": null,
      "seed": 529126590,
      "version": 773,
      "versionNonce": 1489731838,
      "isDeleted": true,
      "boundElements": [],
      "updated": 1793921202287,
      "created": 1793920761259,
      "link": null,
      "locked": false,
      "text": "When sending a pull request to sync-srvc, the sync-engine also includes the metadata of all files currently\navailable in the local environment.\n\nBased on the file versions and the number of files present locally, the sync-engine determines which files need\nto be synchronized and makes the corresponding requests to the Sync Service.\n\nThe Sync Service first validates the versions of all requested files against the metadata stored in its database.\nIt retrieves the latest available version of each file and compares it with the version of the corresponding file in\nthe local environment.\n\nIf a version mismatch is detected, the Sync Service identifies the affected file as outdated and notifies the client\nthat the file needs to be downloaded again to obtain the latest version.",
      "fontSize": 16,
      "baseFontSize": null,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "When sending a pull request to sync-srvc, the sync-engine also includes the metadata of all files currently available in the local environment.\n\nBased on the file versions and the number of files present locally, the sync-engine determines which files need to be synchronized and makes the corresponding requests to the Sync Service.\n\nThe Sync Service first validates the versions of all requested files against the metadata stored in its database. It retrieves the latest available version of each file and compares it with the version of the corresponding file in the local environment.\n\nIf a version mismatch is detected, the Sync Service identifies the affected file as outdated and notifies the client that the file needs to be downloaded again to obtain the latest version.",
      "autoResize": false,
      "lineHeight": 1.25,
      "labelPosition": null
    },
