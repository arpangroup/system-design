    },
    {
      "id": "IC84grmjNZ3bAUAgrzZkN",
      "type": "text",
      "x": -217.29621549531396,
      "y": 1887.1423278510736,
      "width": 800,
      "height": 20,
      "angle": 0,
      "strokeColor": "#52575c",
      "backgroundColor": "#ffffff",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b20",
      "roundness": null,
      "seed": 1795343998,
      "version": 42,
      "versionNonce": 1790925922,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1793915762739,
      "created": 1793915741663,
      "link": null,
      "locked": false,
      "text": "",
      "fontSize": 16,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
