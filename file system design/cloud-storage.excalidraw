    {
      "id": "KNnGAUwBDYOLBgYR2jCv-",
      "type": "text",
      "x": 418.99111139133674,
      "y": 1832.2767984486193,
      "width": 800,
      "height": 160,
      "angle": 0,
      "strokeColor": "#52575c",
      "backgroundColor": "#ffffff",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b1t",
      "roundness": null,
      "seed": 1677456930,
      "version": 1002,
      "versionNonce": 943451134,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1793918306507,
      "created": 1793915090313,
      "link": null,
      "locked": false,
      "text": "1. user directly upload the chunk to S3\n2. S3 bucket will response the success message to the server and \n    - file-uploader-srvc will consume the SUCCESS event and\n    - validate the chunk that got uploaded\n3. The S3 will return hash (SHA256) of the particular chunk\n4. Our backend will store the SHA256 hash in the Redis cache\n5. If the hash generated by the client and the hash stored in the backend match for that particular\nchunk, then only we can validate and tell the file got uploaded without any problem or corruption.",
      "fontSize": 16,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "1. user directly upload the chunk to S3\n2. S3 bucket will response the success message to the server and \n    - file-uploader-srvc will consume the SUCCESS event and\n    - validate the chunk that got uploaded\n3. The S3 will return hash (SHA256) of the particular chunk\n4. Our backend will store the SHA256 hash in the Redis cache\n5. If the hash generated by the client and the hash stored in the backend match for that particular chunk, then only we can validate and tell the file got uploaded without any problem or corruption.",
      "autoResize": false,
      "lineHeight": 1.25,
      "labelPosition": null
    },
